<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>top.binaryx.ddd</groupId>
    <artifactId>java-standards-ddd</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <modules>
        <module>java-standards-common</module>
        <module>java-standards-api</module>
        <module>java-standards-infra</module>
        <module>java-standards-service</module>
        <module>java-standards-facade</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis.plus.version>3.5.17</mybatis.plus.version>
        <junit.version>5.10.2</junit.version>
        <revision>1.0.0</revision>
        <lombok.version>1.18.34</lombok.version>
        <junit.version>5.10.2</junit.version>
        <mockito.version>5.6.0</mockito.version>
        <jacoco.version>0.8.12</jacoco.version>
        <p3c.version>2.1.1</p3c.version>
    </properties>

    <!-- 全局统一引入Lombok，所有子模块直接使用 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <!-- 统一版本管理 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>top.binaryx.ddd</groupId>
                <artifactId>java-standards-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>top.binaryx.ddd</groupId>
                <artifactId>java-standards-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>top.binaryx.ddd</groupId>
                <artifactId>java-standards-infra</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>top.binaryx.ddd</groupId>
                <artifactId>java-standards-service</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>top.binaryx.ddd</groupId>
                <artifactId>java-standards-facade</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <build>

        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <encoding>UTF-8</encoding>
                        <source>21</source>
                        <target>21</target>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.3.1</version>
                    <configuration>
                        <skipTests>false</skipTests>
                    </configuration>
                    <executions>
                        <execution>
                            <id>jacoco-report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>test</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>com.alibaba.p3c</groupId>
                    <artifactId>p3c-maven-plugin</artifactId>
                    <version>${p3c.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
